<!-- pages/saving/saving.wxml - 存钱段位 -->
<view class="container {{isDark ? 'is-dark' : ''}}" style="background-color: {{isDark ? '#1a1a2e' : '#f5f7fa'}}">

  <!-- 模式切换 -->
  <view class="card">
    <view class="mode-toggle">
      <view class="mode-btn {{mode === 'forward' ? 'active' : ''}}" bindtap="switchMode" data-mode="forward">📊 正向算段位</view>
      <view class="mode-btn {{mode === 'reverse' ? 'active' : ''}}" bindtap="switchMode" data-mode="reverse">🎯 目标倒推</view>
    </view>
  </view>

  <!-- 正向模式：收入+支出 -->
  <view wx:if="{{mode === 'forward'}}">
    <view class="card">
      <view class="card-title">💰 你的收支</view>
      <calc-input label="月收入（元）" symbol="¥" desc="税后到手月收入，含工资+副业" field="income" value="{{income}}" bind:input="onInput" />
      <calc-input label="月支出（元）" symbol="¥" desc="月度各项支出合计" field="expense" value="{{expense}}" bind:input="onInput" />
      <view class="link-row">
        不确定支出？去
        <text class="link-text" bindtap="goExpense">🧮 家庭支出计算</text>
        获取月度支出
      </view>
    </view>
  </view>

  <!-- 倒推模式：目标+年限+月支出 -->
  <view wx:if="{{mode === 'reverse'}}">
    <view class="card">
      <view class="card-title">🎯 你的目标</view>
      <calc-input label="想存多少钱（元）" symbol="¥" desc="N 年后想攒到的总金额" field="goalAmount" value="{{goalAmount}}" bind:input="onInput" />
      <view class="input-row">
        <view class="input-label">打算几年存到？</view>
        <picker range="{{goalYearOptions}}" value="{{goalYearIdx}}" bindchange="onPickYear">
          <view class="input-wrapper">
            <view class="input-field" style="color: {{goalYearIdx > 0 ? 'var(--text-primary)' : 'var(--text-muted)'}}">{{goalYearOptions[goalYearIdx]}}</view>
          </view>
        </picker>
        <view class="input-desc">1~30 年，选个现实的时间</view>
      </view>
      <calc-input label="预计月支出（元）" symbol="¥" desc="保持现有生活水平需要的月支出" field="expense" value="{{expense}}" bind:input="onInput" />
      <view class="link-row">
        不确定支出？去
        <text class="link-text" bindtap="goExpense">🧮 家庭支出计算</text>
        获取月度支出
      </view>
    </view>
  </view>

  <!-- 按钮：计算 + 重置 -->
  <view class="btn-row">
    <button class="btn btn-calc" bindtap="doCalculate">计算</button>
    <button class="btn btn-secondary" bindtap="reset">重置</button>
  </view>

  <!-- 正向结果 -->
  <view class="result-area {{showResult ? 'show' : ''}}" wx:if="{{showResult && mode === 'forward'}}">
    <view class="result-gradient-card" style="background: linear-gradient(135deg, {{rank ? rank.color : '#667eea'}}15, var(--bg-card-alt));">
      <view class="rank-badge-wrap" wx:if="{{rank}}">
        <view class="rank-badge" style="background: {{rank.color}}">
          <text class="rank-emoji">{{rank.emoji}}</text>
          <text class="rank-name">{{rank.name}}段位</text>
        </view>
      </view>
      <view class="big-rate-wrap">
        <view class="big-rate-label">每月储蓄率</view>
        <view class="big-rate-value" style="color: {{rank ? rank.color : '#333'}}">{{savingRateStr}}</view>
        <view class="big-rate-sub">每月存下 ¥{{savingStr}}</view>
      </view>
      <view class="divider-line"></view>
      <view class="wealth-age-wrap">
        <view class="wealth-age-label">你的存钱习惯相当于</view>
        <view class="wealth-age-value">{{wealthAge}} <text class="wealth-age-unit">岁</text></view>
        <view class="wealth-age-tip">{{wealthAgeComment}}</view>
      </view>
      <view class="forecast-wrap">
        <view class="forecast-label">📈 未来预测</view>
        <view class="forecast-sub">照此速度，一年后你能多存 <text class="forecast-num">¥{{yearlySaved}}</text></view>
        <view class="forecast-compare" wx:if="{{yearlyCompare}}">
          <text class="compare-icon">{{yearlyCompare}}</text>
        </view>
      </view>
      <view class="disclaimer">⚠️ 本测试结果仅供娱乐，不代表用户真实水平</view>
    </view>
  </view>

  <!-- 倒推结果 -->
  <view class="result-area {{showResult ? 'show' : ''}}" wx:if="{{showResult && mode === 'reverse'}}">
    <view class="result-gradient-card" style="background: linear-gradient(135deg, {{rank ? rank.color : '#667eea'}}15, var(--bg-card-alt));">
      <view class="rank-badge-wrap" wx:if="{{rank}}">
        <view class="rank-badge" style="background: {{rank.color}}">
          <text class="rank-emoji">{{rank.emoji}}</text>
          <text class="rank-name">{{rank.name}}段位</text>
        </view>
      </view>
      <view class="big-rate-wrap">
        <view class="big-rate-label">每个月需要存</view>
        <view class="big-rate-value" style="color: {{rank ? rank.color : '#333'}}">¥{{savingStr}}</view>
        <view class="big-rate-sub">储蓄率 {{savingRateStr}}</view>
      </view>
      <view class="divider-line"></view>
      <view class="wealth-age-wrap">
        <view class="wealth-age-label">为此你需要月收入至少</view>
        <view class="wealth-age-value" style="color: #27ae60">{{goalIncomeStr}} <text class="wealth-age-unit">元</text></view>
        <view class="wealth-age-tip">含月支出 ¥{{expenseStr}} + 月储蓄 ¥{{savingStr}}</view>
      </view>
      <view class="disclaimer">⚠️ 倒推为理想化计算，未考虑通胀与意外支出</view>
    </view>
  </view>

  <!-- 按钮：首页/保存/分享 -->
  <view class="btn-row">
    <button class="btn btn-home" bindtap="goHome">首页</button>
    <button class="btn btn-save" bindtap="saveResult" disabled="{{isSaving}}">保存</button>
    <button class="btn btn-share" open-type="share" disabled="{{!showResult}}">分享</button>
  </view>
  <view class="tip">点击「保存」可将结果存入历史，方便日后查看</view>

  <view class="page-bottom-spacer"></view>
  <canvas type="2d" id="saveCanvas" class="save-canvas" style="width:300px;height:670px"></canvas>
  <view class="ad-banner-wrap">
    <ad unit-id="adunit-banner-saving-001" ad-type="banner" ad-theme="white"></ad>
  </view>

</view>
