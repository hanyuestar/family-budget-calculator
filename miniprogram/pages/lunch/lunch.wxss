/* pages/lunch/lunch.wxss - 中午吃什么（水墨道教风，rpx 适配） */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5efe2 0%, #f0e8d8 50%, #e8dfc8 100%);
  position: relative;
}
.container.is-dark {
  background: linear-gradient(180deg, #16161f 0%, #1a1a2e 60%, #20203a 100%);
}

.screen {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}
.screen.result {
  justify-content: flex-start;
  padding-top: 24rpx;
  padding-bottom: 40rpx;
}

/* ===== 迎宾 ===== */
.daoist-img {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 24rpx;
  opacity: 0.96;
}
.welcome-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #2a1f14;
  letter-spacing: 20rpx;
  margin-bottom: 20rpx;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}
.welcome-title .cinnabar { color: #a02828; }
.welcome-sub {
  font-size: 26rpx;
  color: #4a3a28;
  letter-spacing: 4rpx;
  line-height: 1.9;
  text-align: center;
  margin-bottom: 24rpx;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}
.divider-ink {
  width: 360rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}
.divider-ink::before, .divider-ink::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, #8a7a65, transparent);
}
.divider-ink .seal-small {
  width: 44rpx;
  height: 44rpx;
  background: #a02828;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 16rpx;
  color: #f5efe2;
  font-size: 22rpx;
  font-weight: 700;
  transform: rotate(-3deg);
}
.btn-fortune {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76%;
  max-width: 520rpx;
  min-width: 300rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #a02828, #7a1818);
  color: #f5efe2;
  border: none;
  padding: 26rpx 0;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  border-radius: 8rpx;
  box-shadow: 0 6rpx 24rpx rgba(160, 40, 40, 0.25);
  white-space: nowrap;
  overflow: hidden;
}
.btn-fortune::after { border: none; }
.welcome-footer {
  position: absolute;
  bottom: 16rpx;
  left: 0; right: 0;
  text-align: center;
  font-size: 21rpx;
  color: #8a7a65;
  letter-spacing: 4rpx;
  opacity: 0.6;
}

/* ===== 推演中 ===== */
.taiji-spin {
  font-size: 140rpx;
  color: #a02828;
  margin-bottom: 56rpx;
  animation: taiji-spin 12s linear infinite;
  text-shadow: 0 4rpx 12rpx rgba(42, 31, 20, 0.15);
}
@keyframes taiji-spin { to { transform: rotate(360deg); } }
.loading-text {
  font-size: 33rpx;
  color: #2a1f14;
  letter-spacing: 8rpx;
  line-height: 2;
  max-width: 600rpx;
  text-align: center;
  min-height: 120rpx;
}
.loading-hint {
  margin-top: 36rpx;
  font-size: 27rpx;
  color: #a02828;
  letter-spacing: 8rpx;
  opacity: 0.65;
  animation: hint-blink 2s ease-in-out infinite;
}
@keyframes hint-blink { 0%,100% { opacity: 0.35; } 50% { opacity: 0.85; } }

/* ===== 结果 ===== */
.result-header {
  width: 100%;
  max-width: 880rpx;
  text-align: center;
  margin-bottom: 28rpx;
  position: relative;
}
.result-header .back-btn {
  position: absolute;
  left: 0; top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: #4a3a28;
  padding: 8rpx 20rpx;
  opacity: 0.55;
}
.result-title {
  font-size: 42rpx;
  letter-spacing: 16rpx;
  color: #2a1f14;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}

.scroll-card {
  width: 100%;
  max-width: 880rpx;
  position: relative;
  margin-bottom: 28rpx;
  background: linear-gradient(180deg, #f5efe2 0%, #f0e8d8 50%, #e0d5be 100%);
  border-radius: 4rpx;
  box-shadow: 0 6rpx 28rpx rgba(42, 31, 20, 0.1), inset 0 0 50rpx rgba(160, 128, 80, 0.05);
  color: #2a1f14;
  overflow-wrap: anywhere;
}
.scroll-card::before, .scroll-card::after {
  content: "";
  position: absolute;
  left: -8rpx; right: -8rpx;
  height: 22rpx;
  background: linear-gradient(180deg, #8a6a40 0%, #6a4f28 50%, #5a4220 100%);
  border-radius: 2rpx;
}
.scroll-card::before { top: -10rpx; }
.scroll-card::after { bottom: -10rpx; }
.scroll-card .scroll-inner { padding: 36rpx 32rpx; }

.huangli-bar .scroll-inner {
  padding: 22rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}
.hl-item { font-size: 24rpx; color: #6a5a45; letter-spacing: 2rpx; }
.hl-item .strong { color: #2a1f14; font-weight: 700; }
.hl-yi { color: #4a6a4a; }
.hl-ji { color: #a02828; }

.gua-card .scroll-inner { text-align: center; padding: 44rpx 36rpx 36rpx; }
.gua-symbol {
  font-size: 108rpx;
  color: #a02828;
  line-height: 1;
  margin-bottom: 12rpx;
  text-shadow: 0 0 24rpx rgba(160, 40, 40, 0.12);
}
.gua-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #2a1f14;
  letter-spacing: 16rpx;
  margin-bottom: 8rpx;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}
.gua-meta {
  font-size: 26rpx;
  color: #6a5a45;
  letter-spacing: 4rpx;
  margin-bottom: 28rpx;
}
.gua-meta .wx { color: #4a6a4a; font-weight: 600; }
.gua-meta .dir { color: #3a5a6a; font-weight: 600; margin-left: 16rpx; }
.qianwen {
  font-size: 30rpx;
  color: #7a1818;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.9;
  padding: 20rpx 12rpx;
  border-top: 1rpx dashed #c9b896;
  border-bottom: 1rpx dashed #c9b896;
  margin-bottom: 24rpx;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}
.jieqian {
  font-size: 27rpx;
  color: #4a3a28;
  line-height: 1.95;
  letter-spacing: 1rpx;
  text-align: justify;
  margin-bottom: 20rpx;
}
.food-hint {
  font-size: 25rpx;
  color: #4a6a4a;
  line-height: 1.75;
  padding: 18rpx 22rpx;
  background: rgba(74, 106, 74, 0.06);
  border-radius: 4rpx;
  border-left: 6rpx solid #4a6a4a;
  text-align: left;
}

.restaurant-card .scroll-inner { padding: 36rpx 32rpx 32rpx; }
.restaurant-card .seal {
  position: absolute;
  top: 24rpx; right: 20rpx;
  z-index: 3;
  width: 88rpx; height: 88rpx;
  background: #a02828;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: rotate(6deg);
  box-shadow: 0 4rpx 12rpx rgba(160, 40, 40, 0.25);
}
.restaurant-card .seal text {
  color: #f5efe2;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  writing-mode: vertical-rl;
  line-height: 1.2;
}
.rc-label { font-size: 24rpx; color: #6a5a45; letter-spacing: 4rpx; margin-bottom: 10rpx; }
.rc-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #2a1f14;
  letter-spacing: 3rpx;
  margin-bottom: 20rpx;
  line-height: 1.35;
  padding-right: 96rpx;
}
.rc-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.rc-tag {
  font-size: 23rpx;
  padding: 6rpx 18rpx;
  border-radius: 4rpx;
  letter-spacing: 2rpx;
  background: rgba(160, 40, 40, 0.07);
  color: #7a1818;
  border: 1rpx solid rgba(160, 40, 40, 0.12);
}
.rc-tag.jade { background: rgba(74, 106, 74, 0.07); color: #4a6a4a; border-color: rgba(74, 106, 74, 0.18); }
.rc-tag.gold { background: rgba(160, 128, 48, 0.09); color: #a08030; border-color: rgba(160, 128, 48, 0.22); }
.rc-addr {
  font-size: 25rpx;
  color: #6a5a45;
  line-height: 1.75;
  letter-spacing: 1rpx;
  padding-top: 18rpx;
  border-top: 1rpx dashed #c9b896;
}

.result-actions {
  width: 100%;
  max-width: 880rpx;
  display: flex;
  gap: 24rpx;
  margin-top: 4rpx;
}
.btn-secondary {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 3rpx solid #4a3a28;
  color: #4a3a28;
  padding: 26rpx 16rpx;
  font-size: 31rpx;
  letter-spacing: 6rpx;
  border-radius: 4rpx;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
}
.btn-secondary::after { border: none; }
.btn-primary {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #a02828, #7a1818);
  color: #f5efe2;
  border: none;
  padding: 26rpx 16rpx;
  font-size: 31rpx;
  letter-spacing: 6rpx;
  border-radius: 4rpx;
  box-shadow: 0 6rpx 20rpx rgba(160, 40, 40, 0.22);
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
}
.btn-primary::after { border: none; }
.result-footer {
  margin-top: 44rpx;
  font-size: 23rpx;
  color: #8a7a65;
  letter-spacing: 6rpx;
  text-align: center;
  opacity: 0.55;
}

.footer-bar {
  width: 100%;
  max-width: 880rpx;
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.btn-home, .btn-share, .btn-save {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 29rpx;
  letter-spacing: 6rpx;
  border-radius: 4rpx;
  background: #e0d5be;
  color: #2a1f14;
  border: 1rpx solid #c9b896;
  box-sizing: border-box;
  white-space: nowrap;
  overflow: hidden;
}
.btn-home::after, .btn-share::after, .btn-save::after { border: none; }
.btn-save { background: linear-gradient(135deg, #a02828, #7a1818); color: #f5efe2; border: none; }
.btn-save[disabled] { opacity: 0.5; }

/* ===== 拒绝 / 无餐厅 ===== */
.denied-icon { font-size: 116rpx; margin-bottom: 28rpx; opacity: 0.45; color: #4a3a28; }
.denied-text {
  font-size: 31rpx;
  color: #4a3a28;
  line-height: 2;
  letter-spacing: 4rpx;
  margin-bottom: 44rpx;
  text-align: center;
  max-width: 640rpx;
  font-family: "STKaiti", "KaiTi", "楷体", serif;
}
.loc-err {
  font-size: 22rpx;
  color: #a02828;
  line-height: 1.7;
  letter-spacing: 1rpx;
  margin: -20rpx 0 40rpx;
  padding: 14rpx 20rpx;
  max-width: 640rpx;
  text-align: center;
  background: rgba(160, 40, 40, 0.06);
  border: 1rpx dashed rgba(160, 40, 40, 0.25);
  border-radius: 4rpx;
  word-break: break-all;
}
.container.is-dark .loc-err { color: #e08a8a; background: rgba(160, 40, 40, 0.1); }

/* ===== 暗色适配 ===== */
.container.is-dark .welcome-title,
.container.is-dark .result-title,
.container.is-dark .gua-name,
.container.is-dark .gua-symbol,
.container.is-dark .rc-name,
.container.is-dark .hl-item .strong { color: #ece3d0; }
.container.is-dark .welcome-sub,
.container.is-dark .gua-meta,
.container.is-dark .jieqian,
.container.is-dark .rc-addr,
.container.is-dark .hl-item,
.container.is-dark .rc-label { color: #c9b896; }
.container.is-dark .scroll-card {
  background: linear-gradient(180deg, #2a2a3a 0%, #23232f 50%, #1c1c28 100%);
  color: #ece3d0;
}
.container.is-dark .btn-fortune,
.container.is-dark .btn-primary { color: #f5efe2; }
.container.is-dark .btn-secondary { border-color: #8a7a65; color: #c9b896; }
.container.is-dark .btn-home,
.container.is-dark .btn-share { background: #2a2a3a; color: #ece3d0; border-color: #4a4a5a; }
.container.is-dark .denied-text { color: #c9b896; }

/* 隐藏出图画布 */
.save-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 300px;
  height: 610px;
}
