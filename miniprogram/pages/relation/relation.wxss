/* pages/relation/relation.wxss - 亲戚关系 */

.container { padding: 24rpx; padding-bottom: 40rpx; }

.card { background: var(--bg-card); border-radius: 24rpx; padding: 32rpx 28rpx; margin-bottom: 24rpx; box-shadow: var(--card-shadow); }
.card-title { font-size: 32rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 28rpx; }

.rel-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14rpx; margin-bottom: 14rpx; }
.rel-card { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 120rpx; border-radius: 14rpx; background: var(--bg-card); border: 1rpx solid var(--border); box-shadow: 0 2rpx 8rpx var(--shadow-block); }
.rel-card:active { background: var(--bg-card-alt); border-color: var(--text-muted); }
.rel-char { font-size: 38rpx; font-weight: 700; color: var(--text-primary); margin-bottom: 6rpx; }
.rel-label { font-size: 20rpx; color: var(--text-muted); }

.action-bar { display: flex; gap: 24rpx; }
.act-btn { flex: 1; height: 80rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 500; border-radius: 14rpx; background: var(--bg-card); color: var(--text-secondary); border: 1rpx solid var(--border); }
.act-btn:active { background: var(--bg-page); }
.act-btn[disabled] { background: var(--bg-card-alt); color: var(--text-light); border-color: var(--border-light); }

.path-card { background: linear-gradient(135deg, #667eea, #764ba2); padding: 36rpx 32rpx; }
.path-label { font-size: 26rpx; color: rgba(255, 255, 255, 0.8); margin-bottom: 16rpx; }
.path-text { font-size: 44rpx; font-weight: 700; color: #ffffff; line-height: 1.4; }

.result-card { min-height: 200rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx 32rpx; }
.result-title { font-size: 30rpx; color: var(--text-muted); margin-bottom: 24rpx; }
.result-text { font-size: 76rpx; font-weight: 800; color: #e74c3c; text-align: center; line-height: 1.3; }
.result-text.grey { font-size: 36rpx; color: var(--text-muted); font-weight: 500; }

.age-pick { display: flex; flex-direction: column; gap: 16rpx; margin-top: 32rpx; width: 100%; }
.age-btn { width: 100%; height: 96rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; border-radius: 16rpx; border: none; color: #ffffff; padding: 0; margin: 0; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15); }
.age-btn:first-child { background: linear-gradient(135deg, #667eea, #764ba2); }
.age-btn:last-child { background: linear-gradient(135deg, #11998e, #38ef7d); }
.age-btn:active { opacity: 0.85; transform: scale(0.97); }
.age-btn::after { border: none; }

.bottom-bar { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.btn { flex: 1; height: 84rpx; line-height: 84rpx; text-align: center; border-radius: 42rpx; font-size: 30rpx; font-weight: 600; color: #ffffff; border: none; }
.btn-home { background: linear-gradient(135deg, #667eea, #764ba2); }
.btn-save { background: linear-gradient(135deg, #11998e, #38ef7d); }
.btn-share { background: linear-gradient(135deg, #fa709a, #fee140); }
.btn[disabled] { opacity: 0.5; }

.tip { text-align: center; font-size: 24rpx; color: var(--text-light); margin-bottom: 20rpx; }
