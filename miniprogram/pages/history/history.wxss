/* pages/history/history.wxss - 历史记录页样式 */

.history-container {
  min-height: 100vh;
  background-color: var(--bg-page);
  padding: 24rpx;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.filter-tag {
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  background: var(--bg-card);
  border: 1rpx solid var(--border);
}

.filter-tag.active {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-color: transparent;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }

.empty-text {
  font-size: 32rpx;
  color: var(--text-secondary);
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: var(--text-muted);
}

/* 列表 */
.history-item {
  display: flex;
  align-items: center;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--card-shadow);
  gap: 16rpx;
}

.hi-left { flex-shrink: 0; }

.hi-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: var(--bg-card-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.hi-center { flex: 1; min-width: 0; }

.hi-tool {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.hi-summary {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 6rpx;
}

.hi-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.hi-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.hi-star {
  font-size: 32rpx;
  padding: 4rpx;
}

.hi-star.starred { }

.hi-remove {
  font-size: 22rpx;
  color: var(--text-muted);
  padding: 4rpx;
}

/* 底部 */
.bottom-actions {
  text-align: center;
  padding: 32rpx 0;
}

.btn-clear {
  display: inline-block;
  padding: 16rpx 48rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  background: var(--btn-secondary-bg);
  border: 1rpx solid var(--border);
}
