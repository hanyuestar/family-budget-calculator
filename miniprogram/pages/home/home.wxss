/* pages/home/home.wxss - 首页样式 */

.home-container {
  min-height: 100vh;
  background-color: var(--bg-page);
}

/* 顶部标题区：渐变背景（暗色下加深） */
.home-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 64rpx 40rpx 48rpx;
  text-align: center;
  position: relative;
}

.home-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.home-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 2rpx;
}

/* 主题切换按钮（右上角） */
.theme-btn {
  position: absolute;
  top: 24rpx;
  right: 32rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
}

/* 历史入口行（标题区下方） */
.history-entry {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 32rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 32rpx;
  display: inline-flex;
  margin-left: auto;
  margin-right: auto;
}

.history-entry-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

.history-entry-badge {
  background: rgba(255,255,255,0.3);
  color: #fff;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}

/* 工具卡片列表 - 自适应网格 */
.tool-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 24rpx;
}

.tool-list.cols-2 .tool-card { width: calc(50% - 12rpx); }
.tool-list.cols-3 .tool-card { width: calc(33.34% - 12rpx); }
.tool-list.cols-4 .tool-card { width: calc(25% - 12rpx); }

.tool-list.cols-4 .tool-icon { font-size: 52rpx; }
.tool-list.cols-4 .tool-name { font-size: 26rpx; }

/* 工具卡片 */
.tool-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  background: var(--bg-card);
  border-radius: 20rpx;
  padding: 32rpx 20rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--card-shadow);
  transition: transform 0.2s ease;
  position: relative;
  overflow: hidden;
}

.tool-card:active { transform: scale(0.97); }

.tool-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  line-height: 1;
}

.tool-info { width: 100%; }

.tool-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

/* 🔥 角标 */
.hot-corner {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 28rpx;
  line-height: 1;
  animation: hotPulse 1.5s ease-in-out infinite;
  filter: drop-shadow(0 1rpx 2rpx rgba(255, 80, 0, 0.4));
}

@keyframes hotPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.75; transform: scale(1.15); }
}

.tool-desc {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.4;
}

/* 底部小字 */
.home-footer {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-light);
  padding: 40rpx 0 60rpx;
}
