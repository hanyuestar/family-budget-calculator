/* subpackages/tarot/pages/index/index.wxss - 牌阵选择 */

.container { min-height: 100vh; background-color: #f5f7fa; }
.container.is-dark { background-color: #1a1a2e; }

.tarot-header {
  background: linear-gradient(135deg, #5b3a89 0%, #3a2b5f 100%);
  padding: 60rpx 40rpx 48rpx;
  text-align: center;
}
.tarot-title {
  font-size: 48rpx; font-weight: 700; color: #fff; letter-spacing: 6rpx;
}
.tarot-sub {
  font-size: 26rpx; color: rgba(255,255,255,0.82); margin-top: 12rpx;
}
.disclaimer-inline {
  display: inline-block;
  margin-top: 20rpx;
  font-size: 20rpx; color: rgba(255,255,255,0.7);
  background: rgba(255,255,255,0.12);
  padding: 6rpx 20rpx; border-radius: 24rpx;
}

.spread-list { padding: 24rpx; }

.spread-card {
  display: flex; align-items: center;
  background: var(--bg-card, #ffffff);
  border-radius: 20rpx; padding: 32rpx; margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  position: relative; overflow: hidden;
}
.is-dark .spread-card { background: #222240; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.30); }

.spread-emoji { font-size: 56rpx; margin-right: 24rpx; line-height: 1; }

.spread-info { flex: 1; }
.spread-name { font-size: 32rpx; font-weight: 600; color: #333; }
.is-dark .spread-name { color: #e0e0e0; }
.spread-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; line-height: 1.4; }
.is-dark .spread-desc { color: #888; }

.spread-count {
  font-size: 24rpx; color: #8e44ad; font-weight: 600;
  background: rgba(142,68,173,0.1); padding: 8rpx 18rpx; border-radius: 24rpx;
  margin-right: 12rpx;
}
.is-dark .spread-count { background: rgba(142,68,173,0.25); color: #c79bf0; }

.spread-arrow { font-size: 48rpx; color: #ccc; line-height: 1; }
.is-dark .spread-arrow { color: #555; }

.tip { font-size: 22rpx; color: #bbb; text-align: center; margin: 20rpx 0 40rpx; }

.ad-banner-wrap {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 100;
  background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
  padding: 8rpx 0; display: flex; justify-content: center; min-height: 96rpx;
}
.is-dark .ad-banner-wrap { background: #222240; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.30); }

.page-bottom-spacer { height: 120rpx; }
