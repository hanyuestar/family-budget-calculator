/* subpackages/tarot/pages/draw/draw.wxss - 抽牌 / 结果 */

.container { min-height: 100vh; background-color: #f5f7fa; padding-bottom: 40rpx; }
.container.is-dark { background-color: #1a1a2e; }

.draw-header {
  background: linear-gradient(135deg, #5b3a89 0%, #3a2b5f 100%);
  padding: 40rpx; text-align: center;
}
.draw-title { font-size: 38rpx; font-weight: 700; color: #fff; letter-spacing: 4rpx; }
.draw-sub { font-size: 22rpx; color: rgba(255,255,255,0.78); margin-top: 8rpx; }

/* 洗牌态 - 牌堆 riffle 洗牌动画 */
.shuffle-box { padding: 140rpx 0; text-align: center; }
.shuffle-deck {
  position: relative;
  width: 160rpx; height: 220rpx;
  margin: 0 auto 32rpx;
  animation: riffle 0.7s ease-in-out infinite;
}
.sh-card {
  position: absolute;
  left: 20rpx; top: 10rpx;
  width: 120rpx; height: 200rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #6a4aa8 0%, #3a2b5f 100%);
  border: 2rpx solid rgba(212, 175, 55, 0.7);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.25);
  transform-origin: center center;
}
/* 五张牌层叠交错，模拟双手洗牌的错落感 */
.sc1 { transform: translateX(-36rpx) rotate(-6deg); }
.sc2 { transform: translateX(-18rpx) rotate(-3deg); }
.sc3 { transform: translateX(0rpx) rotate(0deg); }
.sc4 { transform: translateX(18rpx) rotate(3deg); }
.sc5 { transform: translateX(36rpx) rotate(6deg); }

@keyframes riffle {
  0%   { transform: translateX(-26rpx) rotate(-3deg); }
  25%  { transform: translateX(26rpx) rotate(3deg); }
  50%  { transform: translateX(-16rpx) rotate(-2deg); }
  75%  { transform: translateX(16rpx) rotate(2deg); }
  100% { transform: translateX(-26rpx) rotate(-3deg); }
}
.shuffle-text { font-size: 28rpx; color: #8e44ad; }

/* 牌堆 */
.deck { padding: 24rpx; }

.card-item {
  background: var(--bg-card, #fff);
  border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  display: flex; align-items: flex-start;
}
.is-dark .card-item { background: #222240; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.30); }

/* 开牌动画 */
.reveal { opacity: 0; transform: translateY(30rpx); }
.reveal { animation: fadeInCard 0.5s ease forwards; }
@keyframes fadeInCard { to { opacity: 1; transform: translateY(0); } }

.card-img-wrap {
  position: relative; width: 260rpx; flex-shrink: 0; margin-right: 24rpx;
}
.card-img {
  width: 260rpx; height: 300rpx; border-radius: 12rpx;
  background: #f0ecf7; display: block;
}
.card-img.reversed { transform: rotate(180deg); }
.is-dark .card-img { background: #2a2a4a; }

.card-pos {
  position: absolute; left: 0; bottom: 0;
  background: rgba(58,43,95,0.85); color: #fff;
  font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 0 12rpx 0 12rpx;
}

.card-body { flex: 1; min-width: 0; }
.card-name { display: flex; align-items: center; }
.card-cn { font-size: 34rpx; font-weight: 700; color: #333; }
.is-dark .card-cn { color: #e0e0e0; }
.card-ori {
  font-size: 22rpx; font-weight: 600; margin-left: 14rpx;
  padding: 4rpx 14rpx; border-radius: 20rpx;
}
.card-ori.up { color: #27ae60; background: rgba(39,174,96,0.12); }
.card-ori.rev { color: #e67e22; background: rgba(230,126,34,0.12); }
.is-dark .card-ori.up { background: rgba(39,174,96,0.25); }
.is-dark .card-ori.rev { background: rgba(230,126,34,0.25); }

.card-en { font-size: 22rpx; color: #aaa; margin-top: 6rpx; letter-spacing: 1rpx; }

.kw-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 16rpx 0; }
.kw {
  font-size: 22rpx; color: #8e44ad;
  background: rgba(142,68,173,0.1); padding: 6rpx 16rpx; border-radius: 20rpx;
}
.is-dark .kw { background: rgba(142,68,173,0.25); color: #c79bf0; }

.card-today {
  font-size: 26rpx; color: #5b3a89; line-height: 1.6;
  background: rgba(91,58,137,0.06); padding: 16rpx 20rpx; border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.is-dark .card-today { background: rgba(91,58,137,0.18); color: #c79bf0; }

.card-text {
  font-size: 26rpx; color: #666; line-height: 1.7;
}
.is-dark .card-text { color: #b0b0b0; }

.disclaimer {
  font-size: 22rpx; color: #bbb; text-align: center;
  margin: 8rpx 20rpx 24rpx;
}

/* 按钮 */
.btn-row { display: flex; gap: 16rpx; padding: 0 24rpx; margin-bottom: 16rpx; }
.btn-row .btn { flex: 1; margin-bottom: 0; min-width: 0; }

.btn-home { background: linear-gradient(135deg, #667eea, #764ba2); color: #fff; }
.btn-save { background: linear-gradient(135deg, #11998e, #38ef7d); color: #fff; }
.btn-share { background: linear-gradient(135deg, #fa709a, #fee140); color: #fff; }
.btn-redraw { background: linear-gradient(135deg, #5b3a89, #3a2b5f); color: #fff; }

.btn {
  display: flex; align-items: center; justify-content: center;
  height: 80rpx; border-radius: 40rpx; font-size: 28rpx; font-weight: 600;
  border: none; width: 100%; box-sizing: border-box; padding: 0 12rpx;
  white-space: nowrap; overflow: hidden;
}

.save-canvas { position: fixed; left: -9999px; top: -9999px; }

.ad-banner-wrap {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 100;
  background: #fff; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.06);
  padding: 8rpx 0; display: flex; justify-content: center; min-height: 96rpx;
}
.is-dark .ad-banner-wrap { background: #222240; box-shadow: 0 -2rpx 16rpx rgba(0,0,0,0.30); }

.page-bottom-spacer { height: 120rpx; }
